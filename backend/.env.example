DATABASE_URL="postgresql://user:password@host:5432/dbname"
JWT_SECRET="change-this-to-a-random-secret"
JWT_EXPIRES_IN="7d"
PORT=3001
FRONTEND_URL="https://your-app.vercel.app"
GROQ_API_KEY="gsk_..."
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
IDEA_SUBMISSION_FEE=999
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your_secret"
# Test mode: returns the OTP in the API response because no SMS gateway is wired
# up yet. Required in production until one is. Never leave this on afterwards.
OTP_TEST_MODE=false
# Local/demo only: skips the 48-hour founder dashboard wait entirely. In
# production leave this false and use the per-idea admin unlock instead.
DASHBOARD_GATE_BYPASS=false
