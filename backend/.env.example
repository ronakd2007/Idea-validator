DATABASE_URL="postgresql://user:password@host:5432/dbname"
JWT_SECRET="change-this-to-a-random-secret"
JWT_EXPIRES_IN="7d"
PORT=3001
FRONTEND_URL="https://your-app.vercel.app"
GROQ_API_KEY="gsk_..."
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
IDEA_SUBMISSION_FEE=2999
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your_secret"
# Test mode: returns the OTP in the API response because no SMS gateway is wired
# up yet. Required in production until one is. Never leave this on afterwards.
OTP_TEST_MODE=false

# Cloudinary — pitch-video uploads. The browser uploads directly to Cloudinary
# using a short-lived signature minted by the backend, so the file never passes
# through this server and the secret never reaches the client.
# Without these, the upload box degrades to "paste a video link instead".
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="your-api-secret"
