generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  password      String? // null for Google-only accounts — no local password ever set
  googleId      String?  @unique
  role          String // FOUNDER | VALIDATOR | ADMIN
  phone         String?
  phoneVerified Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  validatorProfile ValidatorProfile?
  ideas            Idea[]
  validations      ValidationResponse[]
  payments         Payment[]
  surveys          Survey[]
  activities       Activity[]
  aiConversations  AiConversation[]
  startups         Startup[]
  ipRecords        IpRecord[]
}

model ValidatorProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  occupation         String
  yearsOfExperience  Int
  areasOfExpertise   String
  linkedinUrl        String
  contactPreferences String    @default("[]")
  isApproved         Boolean   @default(false)
  approvedAt         DateTime?
  rejectedAt         DateTime? // set on admin rejection so the application leaves the pending queue permanently
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Idea {
  id                  String   @id @default(cuid())
  founderId           String
  founder             User     @relation(fields: [founderId], references: [id])
  title               String
  videoUrl            String   @default("")
  teamMembers         String   @default("[]") // JSON array of { name, linkedinUrl }
  // Assumption Checker — JSON array of { statement, category? }. Statuses are
  // NEVER stored: they're computed live against current evidence, so they
  // update automatically as validations and survey responses arrive.
  assumptions         String   @default("[]")
  industryCategory    String
  problemStatement    String
  solutionDescription String
  targetCustomer      String
  revenueModel        String
  stage               String
  founderContext      String?
  isRevision          Boolean  @default(false)
  revisionOf          String?
  version             Int      @default(1)
  paymentStatus       String   @default("PENDING")
  submittedAt         DateTime @default(now())

  // Public validation page — mirrors Survey.publicId: minted on first share,
  // non-guessable, revocable via the enabled flag without losing the link.
  publicId            String? @unique
  publicShareEnabled  Boolean @default(false)
  publicShareSettings String  @default("{}") // JSON section toggles, see ideas.service SHARE_DEFAULTS

  // Last generated AI summary, persisted so the dashboard and public page
  // don't re-bill Groq on every view. Null until first generated.
  aiSummary   String?
  aiSummaryAt DateTime?

  // Admin override for the 48h dashboard gate. Set = results are visible now,
  // regardless of the timer. Only an ADMIN route can write this; a founder can
  // never unlock their own idea early.
  // RETIRED (2026-08-13): the 48h dashboard gate was removed entirely — the
  // dashboard is available immediately. Column kept only because dropping it
  // would need a destructive migration; nothing reads or writes it anymore.
  dashboardUnlockedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  selfAssessment   FounderFitSelfAssessment?
  validations      ValidationResponse[]
  payments         Payment[]
  surveys          Survey[]
  aiConversations  AiConversation[]
  aiValidationRuns AiValidationRun[]
  startup          Startup?
  ipRecords        IpRecord[]

  // Postgres does not index FK columns automatically — without this,
  // "all ideas by founder" is a sequential scan.
  @@index([founderId])
}

model FounderFitSelfAssessment {
  id                 String @id @default(cuid())
  ideaId             String @unique
  idea               Idea   @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  industryKnowledge  Int
  relevantExperience Int
  networkAccess      Int
  passion            Int
  skillAlignment     Int
}

model ValidationResponse {
  id          String   @id @default(cuid())
  ideaId      String
  idea        Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  validatorId String
  validator   User     @relation(fields: [validatorId], references: [id])
  createdAt   DateTime @default(now())

  // Founder's rating of how useful this review was: 1 = not helpful,
  // 2 = somewhat, 3 = very helpful. Null until the founder rates it.
  // This is the quality signal that keeps paid/credited reviews honest — a
  // rushed review earns nothing — and it later feeds a validator's public
  // reputation. Only the owning founder can write it.
  helpfulRating Int?
  ratedAt       DateTime?

  marketOpportunity      MarketOpportunityScore?
  feasibility            FeasibilityScore?
  founderFit             FounderFitScore?
  revenuePotential       RevenuePotentialScore?
  scalability            ScalabilityScore?
  riskAssessment         RiskAssessment?
  investorAttractiveness InvestorAttractivenessScore?
  innovation             InnovationScore?
  socialImpact           SocialImpactScore?
  customerValidation     CustomerValidation?
  sharkTank              SharkTankScore?
  startupSuccess         StartupSuccessScore?
  openFeedback           OpenFeedback?

  @@unique([ideaId, validatorId])
  @@index([validatorId]) // validator history lookups; ideaId is covered by the unique above
}

model MarketOpportunityScore {
  id                   String             @id @default(cuid())
  validationResponseId String             @unique
  validationResponse   ValidationResponse @relation(fields: [validationResponseId], references: [id], onDelete: Cascade)
  problemSeverity      Int
  marketSize           Int
  willingnessToPay     Int
  marketGrowthRate     Int
  competitionGap       Int
}

model FeasibilityScore {
  id                   String             @id @default(cuid())
  validationResponseId String             @unique
  validationResponse   ValidationResponse @relation(fields: [validationResponseId], references: [id], onDelete: Cascade)
  technicalComplexity  Int
  capitalRequirement   Int
  regulatoryDifficulty Int
  talentAvailability   Int
  timeToLaunch         Int
}

model FounderFitScore {
  id                   String             @id @default(cuid())
  validationResponseId String             @unique
  validationResponse   ValidationResponse @relation(fields: [validationResponseId], references: [id], onDelete: Cascade)
  industryKnowledge    Int
  relevantExperience   Int
  networkAccess        Int
  passion              Int
  skillAlignment       Int
}

model RevenuePotentialScore {
  id                        String             @id @default(cuid())
  validationResponseId      String             @unique
  validationResponse        ValidationResponse @relation(fields: [validationResponseId], references: [id], onDelete: Cascade)
  pricingPower              Int
  recurringRevenuePotential Int
  profitMarginPotential     Int
  upsellOpportunities       Int
  customerLifetimeValue     Int
}

model ScalabilityScore {
  id                    String             @id @default(cuid())
  validationResponseId  String             @unique
  validationResponse    ValidationResponse @relation(fields: [validationResponseId], references: [id], onDelete: Cascade)
  geographicExpansion   Int
  automationPotential   Int
  operationalComplexity Int
  dependenceOnFounder   Int
  networkEffects        Int
}

model RiskAssessment {
  id                        String             @id @default(cuid())
  validationResponseId      String             @unique
  validationResponse        ValidationResponse @relation(fields: [validationResponseId], references: [id], onDelete: Cascade)
  competitionProbability    String
  competitionImpact         String
  regulatoryProbability     String
  regulatoryImpact          String
  technologyProbability     String
  technologyImpact          String
  fundingProbability        String
  fundingImpact             String
  marketAdoptionProbability String
  marketAdoptionImpact      String
}

model InvestorAttractivenessScore {
  id                   String             @id @default(cuid())
  validationResponseId String             @unique
  validationResponse   ValidationResponse @relation(fields: [validationResponseId], references: [id], onDelete: Cascade)
  marketSize           Int
  growthPotential      Int
  scalability          Int
  exitPotential        Int
  defensibility        Int
}

model InnovationScore {
  id                   String             @id @default(cuid())
  validationResponseId String             @unique
  validationResponse   ValidationResponse @relation(fields: [validationResponseId], references: [id], onDelete: Cascade)
  uniqueness           Int
  patentability        Int
  competitiveAdvantage Int
  disruptionPotential  Int
  defensibility        Int
}

model SocialImpactScore {
  id                   String             @id @default(cuid())
  validationResponseId String             @unique
  validationResponse   ValidationResponse @relation(fields: [validationResponseId], references: [id], onDelete: Cascade)
  jobCreation          Int
  environmentalBenefit Int
  communityBenefit     Int
  inclusion            Int
  sustainability       Int
}

model CustomerValidation {
  id                     String             @id @default(cuid())
  validationResponseId   String             @unique
  validationResponse     ValidationResponse @relation(fields: [validationResponseId], references: [id], onDelete: Cascade)
  wouldUse               Boolean
  wouldPay               Boolean
  wouldRecommend         Boolean
  solvesRealProblem      Boolean
  betterThanAlternatives Boolean
}

model SharkTankScore {
  id                   String             @id @default(cuid())
  validationResponseId String             @unique
  validationResponse   ValidationResponse @relation(fields: [validationResponseId], references: [id], onDelete: Cascade)
  problemImportance    Int
  marketSize           Int
  revenuePotential     Int
  executionEase        Int
  scalability          Int
}

model StartupSuccessScore {
  id                     String             @id @default(cuid())
  validationResponseId   String             @unique
  validationResponse     ValidationResponse @relation(fields: [validationResponseId], references: [id], onDelete: Cascade)
  founderTeam            Int
  marketSize             Int
  productDifferentiation Int
  traction               Int
  businessModel          Int
  competition            Int
  timing                 Int
  fundingReadiness       Int
}

model OpenFeedback {
  id                   String             @id @default(cuid())
  validationResponseId String             @unique
  validationResponse   ValidationResponse @relation(fields: [validationResponseId], references: [id], onDelete: Cascade)
  biggestStrength      String
  biggestWeakness      String
  suggestedImprovement String
}

model OtpVerification {
  id        String   @id @default(cuid())
  phone     String
  otp       String
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Payment {
  id               String   @id @default(cuid())
  ideaId           String
  idea             Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  founderId        String
  founder          User     @relation(fields: [founderId], references: [id])
  amount           Float
  currency         String   @default("USD")
  gateway          String
  gatewayPaymentId String?
  status           String   @default("PENDING")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([ideaId])
  @@index([founderId])
}

// Mass Survey — Phase 1 (builder/draft) + Phase 2 (publish/respond).
// status: DRAFT | LIVE | CLOSED (ARCHIVED reserved for a later phase, no migration needed — plain string).
model Survey {
  id            String   @id @default(cuid())
  ideaId        String? // optional — a survey does not require an Idea to exist; can be created standalone
  idea          Idea?    @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  founderId     String
  founder       User     @relation(fields: [founderId], references: [id])
  title         String
  description   String   @default("")
  status        String   @default("DRAFT")
  publicId      String?  @unique // set on publish; non-guessable, safe to share, never the internal cuid
  // Public results link — a SEPARATE token from publicId so revoking the
  // report never breaks the response-collection link (and vice versa).
  // Deliberately not @unique: adding a unique index to a populated table makes
  // `prisma db push` demand --accept-data-loss, which would fail the Render
  // build (see Idea.publicId). Uniqueness is enforced when minting the token.
  shareId       String?
  shareEnabled  Boolean  @default(false)
  shareSettings String   @default("{}") // JSON section toggles, see survey-share.util REPORT_SHARE_DEFAULTS
  responseLimit Int?
  collectEmail  Boolean  @default(false) // optional self-reported email field on the public form — not a verified/authenticated identity
  // RETIRED (2026-08-16): Focus Mode was removed entirely. Nothing reads or
  // writes this — it is kept only because dropping a populated column is a
  // destructive migration that would fail the deploy, exactly as with
  // Idea.dashboardUnlockedAt. Safe to drop in a deliberate maintenance step.
  focusMode     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Phase 4 — versioning. rootSurveyId is a soft-reference (mirrors Idea.revisionOf,
  // no FK) grouping every version of "the same" survey; null means this row is v1/root.
  rootSurveyId  String?
  versionNumber Int     @default(1)

  questions       SurveyQuestion[]
  sessions        SurveySession[]
  responses       SurveyResponse[]
  incentive       SurveyIncentive?
  aiConversations AiConversation[]

  @@index([founderId])
  @@index([ideaId])
  @@index([shareId])
}

model SurveyQuestion {
  id           String   @id @default(cuid())
  surveyId     String
  survey       Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  type         String // SHORT_ANSWER | PARAGRAPH | MULTIPLE_CHOICE | CHECKBOXES | DROPDOWN | YES_NO | RATING | LINEAR_SCALE | IMAGE_CHOICE
  questionText String
  description  String   @default("")
  required     Boolean  @default(false)
  order        Int
  settings     String   @default("{}") // JSON: rating/linear-scale config ({ max } or { min, max, minLabel, maxLabel })
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Phase 3 — analytics-only settings, never shown to respondents as labels.
  isControlQuestion         Boolean @default(false)
  consistencyPairQuestionId String? // soft-reference to another SurveyQuestion.id in the same survey — mirrors the Idea.revisionOf convention (no FK)
  abGroupKey                String? // questions sharing a key are variants of "the same" question; respondents see exactly one
  abVariant                 String? // 'A' | 'B'

  // Phase 4 — optional media stimulus shown above the question (any type can carry
  // one, e.g. a video before a RATING question). Pasted trusted URL, mirrors
  // Idea.videoUrl — no upload/storage infrastructure exists in this app.
  mediaUrl  String?
  mediaType String? // 'IMAGE' | 'VIDEO'

  options SurveyQuestionOption[]
  answers SurveyAnswer[]

  @@index([surveyId])
}

model SurveyQuestionOption {
  id         String         @id @default(cuid())
  questionId String
  question   SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label      String
  order      Int
  imageUrl   String? // Phase 4 — for IMAGE_CHOICE options (logo/design/packaging comparisons)

  @@index([questionId])
}

// Created when a respondent opens the public link — exists independently of
// whether they ever submit, so Phase 3 can compute drop-off from session vs response counts.
model SurveySession {
  id                String    @id @default(cuid())
  surveyId          String
  survey            Survey    @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  token             String    @unique // opaque, held client-side; also the duplicate-submission guard
  startedAt         DateTime  @default(now())
  lastActivityAt    DateTime  @default(now())
  lastQuestionIndex Int       @default(0) // highest question index reached — the basis for Phase 3 drop-off analysis
  // Seconds the respondent actually had the tab visible, accumulated from 15s
  // client heartbeats (gaps beyond the server-side cap are dropped as idle).
  // The honest completion time — submittedAt-startedAt is wall-clock and can
  // include hours of abandoned-tab idle.
  activeSeconds     Int       @default(0)
  // True once the respondent has actually answered something. Distinguishes a
  // real (partial) attempt from a bare page-open — only engaged or completed
  // sessions count in drop-off analytics. lastQuestionIndex can't carry this:
  // 0 means both "answered Q1" and "never touched the form".
  engaged           Boolean   @default(false)
  submittedAt       DateTime?
  completed         Boolean   @default(false)
  // RETIRED (2026-08-16) alongside Survey.focusMode — see the note there.
  focusEvents       String    @default("[]")

  response SurveyResponse?

  @@index([surveyId])
}

model SurveyResponse {
  id                      String        @id @default(cuid())
  surveyId                String
  survey                  Survey        @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  sessionId               String        @unique
  session                 SurveySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  respondentEmail         String? // only populated if the founder enabled "collect email"
  // true when the email came from a server-verified Google sign-in on the
  // public form (Google-Forms-style auto capture) rather than manual typing.
  respondentEmailVerified Boolean       @default(false)
  submittedAt             DateTime      @default(now())
  createdAt               DateTime      @default(now())

  answers SurveyAnswer[]

  @@index([surveyId])
}

model SurveyAnswer {
  id         String         @id @default(cuid())
  responseId String
  response   SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionId String
  question   SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  value      String // JSON-encoded: string | string[] | number depending on question type

  @@unique([responseId, questionId])
  @@index([questionId]) // per-question analytics; responseId is covered by the unique above
}

// Phase 4 — optional, simple giveaway config. One per survey (founder can offer
// no incentive at all, the default/common case).
model SurveyIncentive {
  id              String    @id @default(cuid())
  surveyId        String    @unique
  survey          Survey    @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  title           String
  description     String    @default("")
  numberOfWinners Int       @default(1)
  eligibility     String    @default("")
  closingDate     DateTime?
  collectContact  Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  entries IncentiveEntry[]
}

// Admin-facing record of meaningful actions performed *inside* the platform.
// Deliberately narrow: one row per meaningful action (see ACTIONS in
// activity.service.ts), never one per API request. Stores no IP address, no
// user-agent, no page views — nothing about the person outside this app.
model Activity {
  id     String  @id @default(cuid())
  userId String? // null for anonymous survey respondents, who have no account by design
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Snapshot of who acted, so the feed still reads correctly if the account is
  // later removed — and so the feed never needs a join to render a row.
  actorRole  String // FOUNDER | VALIDATOR | RESPONDENT | ADMIN
  actorLabel String

  action   String // see ACTIONS in activity.service.ts
  category String // ACCOUNT | IDEAS | SURVEYS | RESPONSES | VALIDATIONS | REPORTS | ADMIN

  targetType  String? // IDEA | SURVEY | VALIDATION | USER
  targetId    String? // soft-reference, mirrors Idea.revisionOf / Survey.rootSurveyId — no FK, so
  targetLabel String? // deleting a target never erases the record that it once happened

  // The founder who owns the target, if any. Lets a respondent's submission
  // surface on that founder's profile as "received a response" from the same
  // single row, instead of writing a second duplicate row.
  ownerUserId String?

  // JSON, platform facts only: ids, counts, statuses. Never personal data.
  metadata String @default("{}")

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([category, createdAt])
  @@index([ownerUserId, createdAt])
  @@index([targetType, targetId])
}

// Deliberately has NO relation to SurveyResponse or SurveySession — this is the
// actual privacy guarantee for anonymous surveys, not just a policy promise.
// A giveaway entry can never be joined back to a specific set of survey answers.
model IncentiveEntry {
  id          String          @id @default(cuid())
  incentiveId String
  incentive   SurveyIncentive @relation(fields: [incentiveId], references: [id], onDelete: Cascade)
  name        String
  contact     String // email or phone, whatever the respondent chose to give
  createdAt   DateTime        @default(now())

  @@index([incentiveId])
}

// AI Validation Assistant — one conversation per (founder, report). Exactly
// one of ideaId/surveyId is ever set; enforced in the service layer, not the
// DB (Postgres treats each NULL as distinct, so the two @@unique constraints
// below correctly scope "one conversation per idea" and "one per survey"
// independently without colliding on the null side).
model AiConversation {
  id        String   @id @default(cuid())
  founderId String
  founder   User     @relation(fields: [founderId], references: [id], onDelete: Cascade)
  ideaId    String?
  idea      Idea?    @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  surveyId  String?
  survey    Survey?  @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AiMessage[]

  @@unique([founderId, ideaId])
  @@unique([founderId, surveyId])
  @@index([founderId])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // USER | ASSISTANT
  content        String
  createdAt      DateTime       @default(now())

  @@index([conversationId])
}

// AI Deep Dive — one row per autonomous research run over an idea.
//
// The row IS the run's state: the pipeline runs in-process (fire-and-forget,
// no queue), so a server restart mid-run leaves a stale RUNNING row that is
// reconciled to FAILED on the next start/poll by comparing updatedAt. Steps
// are therefore written as they progress, which doubles as the heartbeat.
model AiValidationRun {
  id            String    @id @default(cuid())
  ideaId        String
  idea          Idea      @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  status        String    @default("QUEUED") // QUEUED | RUNNING | COMPLETED | FAILED
  steps         String    @default("[]") // JSON array of { key, label, status, detail }
  report        String? // JSON report, whitelisted + clamped before write. Set on COMPLETED
  error         String? // human-readable failure reason. Set on FAILED
  // Server-computed research provenance — never taken from the model.
  webSearchUsed Boolean   @default(false)
  searchCount   Int       @default(0)
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([ideaId])
}

// Public Startup Directory.
//
// The startup — not the validation — is the primary entity here. Validation is
// one optional, founder-controlled section of the profile, deliberately kept as
// derived decoration rather than identity, so this model can later stand on its
// own as a discovery/growth platform (milestones, updates, traction over time)
// without any of it being entangled with IdeaValidator's scoring.
//
// Future sections (Milestones, Updates/Success Stories) belong in their own
// tables keyed on startupId — nothing here needs to change to add them.
model Startup {
  id        String @id @default(cuid())
  // One listing per validated idea. Cascade: deleting the idea (or the founder)
  // removes the listing, so a public page can never outlive its owner.
  ideaId    String @unique
  idea      Idea   @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  founderId String
  founder   User   @relation(fields: [founderId], references: [id], onDelete: Cascade)

  // Readable public URL (/startups/eco-water). Minted from the name and frozen
  // on approval so a live public link never breaks if the name is edited later.
  slug String @unique

  // ---- profile ----
  name        String
  logoUrl     String @default("")
  tagline     String @default("") // one-line description
  about       String @default("")
  problem     String @default("") // prefilled from Idea.problemStatement
  solution    String @default("") // prefilled from Idea.solutionDescription
  product     String @default("") // what's actually built — section hidden when empty
  traction    String @default("") // users/revenue/pilots — section hidden when empty
  industry    String @default("")
  location    String @default("")
  foundedYear Int?
  website     String @default("")
  linkedinUrl String @default("")
  teamMembers String @default("[]") // JSON [{ name, linkedinUrl }] — prefilled from the idea
  stage       String @default("IDEA")

  // JSON array from a fixed set: FUNDING | CUSTOMERS | MENTORS | PARTNERSHIPS | EMPLOYEES | OTHER
  lookingFor String @default("[]")

  // Founder-controlled, opt-in publication of validation aggregates. Whitelisted
  // server-side; the underlying numbers are always computed live from the idea,
  // never copied here, so they can't go stale or be tampered with.
  validationDisplay String @default("{}")

  // DRAFT | PENDING_REVIEW | CHANGES_REQUESTED | APPROVED | REJECTED
  status        String    @default("DRAFT")
  // Shown to the founder so they know what to fix. Distinct from adminNote,
  // which is private and must never leave an ADMIN-guarded route.
  reviewMessage String    @default("")
  adminNote     String    @default("")
  submittedAt   DateTime?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([founderId])
  @@index([status]) // the public directory filters on this on every request
}

// ---------------------------------------------------------------------------
// Innovation & Patent Registry
//
// A founder-maintained record of IP they have filed, hold, or plan to file.
// IdeaValidator does NOT file, register, verify, or grant anything — every
// field here is user-provided, and every surface that renders it says so.
//
// Publication is deliberately TWO locks, both of which must be open:
//   1. visibility   = 'PUBLIC'    — the founder chose to publish
//   2. reviewStatus = 'APPROVED'  — an admin accepted it
// Both are enforced in the Prisma `where` of every public query, never in JS
// after the fetch, so a serialization bug cannot put a record on the registry.
//
// Because review is only triggered by a publish request, records the founder
// keeps private never enter the admin queue at all.
//
// Forward-compatibility: this table is intentionally standalone. A later AI IP
// Strategy report or Disclosure Vault keys off ipRecordId/ideaId and needs no
// change here.
// ---------------------------------------------------------------------------
model IpRecord {
  id        String @id @default(cuid())
  founderId String
  founder   User   @relation(fields: [founderId], references: [id], onDelete: Cascade)

  // Optional on purpose: a founder can hold a trademark that predates any idea
  // on this platform. founderId is the real owner key; the idea link is context.
  ideaId String?
  idea   Idea?   @relation(fields: [ideaId], references: [id], onDelete: SetNull)

  title       String
  description String @default("")
  type        String @default("PATENT") // see IP_TYPES in ip.constants.ts

  // The PATENT's status, managed by the founder. Never inferred, never verified
  // by us. Distinct from reviewStatus below — do not merge these two fields.
  status String @default("PLANNED") // see IP_STATUSES

  applicationNumber String    @default("") // private unless explicitly opted in
  filingDate        DateTime?
  jurisdiction      String    @default("") // country, e.g. "India"
  inventorNames     String    @default("[]") // JSON string array — never public
  ownerName         String    @default("") // never public
  authority         String    @default("") // e.g. "Indian Patent Office"
  publicUrl         String    @default("") // patent-office link, opt-in
  notes             String    @default("") // founder's private notes — NEVER public

  // Founder location, captured on this form because no founder profile stores
  // it. A fixed dropdown on the client keeps `state` countable — free text
  // would yield "Gujarat"/"gujrat"/"GJ" and make the analytics meaningless.
  city        String @default("")
  state       String @default("")
  institution String @default("") // college/institution, optional

  // ---- lock 1: the founder's choice ----
  visibility   String @default("PRIVATE") // PRIVATE | PUBLIC
  publicFields String @default("{}") // JSON opt-ins, see PUBLIC_FIELD_DEFAULTS

  // ---- lock 2: the admin's choice ----
  reviewStatus  String    @default("DRAFT") // DRAFT | PENDING_REVIEW | APPROVED | CHANGES_REQUESTED | REJECTED
  reviewMessage String    @default("") // shown to the founder so they can fix it
  adminNote     String    @default("") // private; only ever leaves an ADMIN route
  submittedAt   DateTime?
  reviewedAt    DateTime?

  documents IpDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([founderId])
  @@index([ideaId])
  @@index([status])
  @@index([type])
  @@index([jurisdiction])
  @@index([visibility])
  @@index([reviewStatus]) // the admin review queue filters on this
  @@index([state]) // the Gujarat analytics group on this
}

// Supporting files for an IP record. These are NEVER included in any public
// payload — no opt-in, no exception. Only the owning founder and an admin can
// see a document URL.
model IpDocument {
  id         String   @id @default(cuid())
  ipRecordId String
  ipRecord   IpRecord @relation(fields: [ipRecordId], references: [id], onDelete: Cascade)

  fileUrl      String
  fileName     String
  documentType String   @default("OTHER") // see IP_DOCUMENT_TYPES
  createdAt    DateTime @default(now())

  @@index([ipRecordId])
}
